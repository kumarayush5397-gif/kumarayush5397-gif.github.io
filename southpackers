<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>South Packers And Movers of India | Packers and Movers Across India</title>
<meta name="description" content="South Packers And Movers of India offers professional household shifting, office shifting, packing, loading-unloading, long-distance moving and vehicle transportation across India, Nepal and Bangladesh.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --blue-900:#0A2E5C;
    --blue-800:#123C6E;
    --blue-700:#1C4E8C;
    --blue-600:#255FA4;
    --blue-500:#2F6FB8;
    --blue-100:#E7EEF7;
    --red-600:#C0272D;
    --red-700:#A31E23;
    --white:#FFFFFF;
    --ivory:#F5F7FA;
    --ink:#101826;
    --slate:#57606E;
    --slate-light:#8A93A3;
    --line:#DEE4ED;
    --radius-sm:6px;
    --radius-md:12px;
    --radius-lg:20px;
    --shadow-1:0 1px 2px rgba(10,46,92,0.06), 0 1px 1px rgba(10,46,92,0.04);
    --shadow-2:0 8px 24px rgba(10,46,92,0.12);
    --shadow-3:0 20px 48px rgba(10,46,92,0.18);
    --ease:cubic-bezier(.22,.9,.3,1);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important;}
  }
  body{
    margin:0;
    font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color:var(--ink);
    background:var(--ivory);
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,h4{
    font-family:'Sora', 'Inter', sans-serif;
    margin:0;
    color:var(--blue-900);
    line-height:1.15;
    font-weight:700;
  }
  p{margin:0;}
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  button{font-family:inherit;cursor:pointer;}
  ul{margin:0;padding:0;list-style:none;}
  section{position:relative;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px;}
  .eyebrow-tag{
    display:inline-flex;align-items:center;gap:8px;
    font-size:13px;font-weight:600;color:var(--blue-600);
    background:var(--blue-100);padding:6px 14px;border-radius:100px;
    margin-bottom:16px;
  }
  .eyebrow-tag .dot{width:6px;height:6px;border-radius:50%;background:var(--red-600);}
  .section-head{max-width:620px;margin-bottom:44px;}
  .section-head h2{font-size:clamp(28px,3.4vw,40px);}
  .section-head p.lede{margin-top:14px;font-size:17px;color:var(--slate);max-width:520px;}
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:10px;
    padding:14px 26px;border-radius:10px;font-weight:600;font-size:15px;
    border:1.5px solid transparent;transition:transform .25s var(--ease), box-shadow .25s var(--ease), background .25s var(--ease);
    white-space:nowrap;
  }
  .btn-primary{background:var(--red-600);color:var(--white);box-shadow:0 10px 24px rgba(192,39,45,0.3);}
  .btn-primary:hover{background:var(--red-700);transform:translateY(-2px);box-shadow:0 14px 30px rgba(192,39,45,0.38);}
  .btn-outline{background:transparent;color:var(--white);border-color:rgba(255,255,255,0.55);}
  .btn-outline:hover{background:rgba(255,255,255,0.12);transform:translateY(-2px);}
  .btn-ghost-blue{background:var(--white);color:var(--blue-700);border-color:var(--line);}
  .btn-ghost-blue:hover{border-color:var(--blue-500);color:var(--blue-800);transform:translateY(-2px);}
  .btn:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, button:focus-visible{
    outline:3px solid var(--blue-500); outline-offset:2px;
  }

  /* ---------- reveal on scroll ---------- */
  .reveal{opacity:0; transform:translateY(22px); transition:opacity .7s var(--ease), transform .7s var(--ease);}
  .reveal.in-view{opacity:1; transform:translateY(0);}
  .reveal-scale{opacity:0; transform:scale(.94); transition:opacity .7s var(--ease), transform .7s var(--ease);}
  .reveal-scale.in-view{opacity:1; transform:scale(1);}
  .reveal-left{opacity:0; transform:translateX(-26px); transition:opacity .7s var(--ease), transform .7s var(--ease);}
  .reveal-left.in-view{opacity:1; transform:translateX(0);}

  /* ================= HEADER ================= */
  header.site-header{
    position:sticky; top:0; z-index:100;
    background:rgba(255,255,255,0.92); backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .header-inner{
    max-width:1180px;margin:0 auto;padding:14px 24px;
    display:flex;align-items:center;justify-content:space-between;gap:20px;
  }
  .logo{display:flex;align-items:center;gap:10px;}
  .logo-mark{
    width:38px;height:38px;border-radius:9px;
    background:linear-gradient(135deg,var(--blue-700),var(--blue-900));
    display:flex;align-items:center;justify-content:center;
    box-shadow:var(--shadow-1);
  }
  .logo-mark svg{width:20px;height:20px;}
  .logo-text{font-family:'Sora',sans-serif;font-weight:700;font-size:16px;color:var(--blue-900);line-height:1.15;}
  .logo-text span{display:block;font-family:'Inter',sans-serif;font-weight:600;font-size:10.5px;letter-spacing:.04em;color:var(--red-600);}
  nav.main-nav{display:flex;align-items:center;gap:30px;}
  nav.main-nav a{font-size:14.5px;font-weight:600;color:var(--slate);transition:color .2s;}
  nav.main-nav a:hover{color:var(--blue-700);}
  .header-cta{display:flex;align-items:center;gap:10px;}
  .header-cta .btn{padding:11px 18px;font-size:14px;}
  .nav-toggle{display:none;background:none;border:none;padding:8px;}
  .nav-toggle span, .nav-toggle span::before, .nav-toggle span::after{
    content:"";display:block;width:22px;height:2px;background:var(--blue-900);border-radius:2px;position:relative;transition:.2s;
  }
  .nav-toggle span::before{position:absolute;top:-7px;}
  .nav-toggle span::after{position:absolute;top:7px;}

  @media (max-width:920px){
    nav.main-nav{
      position:fixed; inset:66px 0 0 0; background:var(--white);
      flex-direction:column; align-items:flex-start; gap:0;
      padding:10px 24px 24px; transform:translateY(-8px); opacity:0; pointer-events:none;
      transition:opacity .25s var(--ease), transform .25s var(--ease);
      border-top:1px solid var(--line);
    }
    nav.main-nav.open{opacity:1; transform:translateY(0); pointer-events:auto;}
    nav.main-nav a{padding:14px 0;width:100%;border-bottom:1px solid var(--line);}
    .header-cta .btn-ghost-blue{display:none;}
    .nav-toggle{display:block;}
  }

  /* ================= HERO ================= */
  .hero{
    position:relative;overflow:hidden;
    background:linear-gradient(180deg,var(--blue-900) 0%, var(--blue-800) 62%, var(--blue-700) 100%);
    padding:74px 0 0;
  }
  .hero::before{
    content:"";position:absolute;inset:0;
    background-image:radial-gradient(circle at 18% 20%, rgba(255,255,255,0.08), transparent 45%),
                      radial-gradient(circle at 85% 15%, rgba(192,39,45,0.18), transparent 40%);
    pointer-events:none;
  }
  .hero-inner{
    max-width:1180px;margin:0 auto;padding:0 24px;
    display:grid;grid-template-columns:1.05fr 0.95fr;gap:40px;align-items:center;
    position:relative;z-index:2;
  }
  .hero-copy{padding:36px 0 60px;}
  .hero-badge{
    display:inline-flex;align-items:center;gap:8px;color:#CFE0F5;font-size:13px;font-weight:600;
    background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.16);
    padding:7px 14px;border-radius:100px;margin-bottom:22px;
  }
  .hero-badge .flag-dot{width:7px;height:7px;border-radius:50%;background:var(--red-600);}
  .hero h1{
    color:var(--white);font-size:clamp(34px,5vw,52px);letter-spacing:-0.01em;
  }
  .hero .tagline{
    color:#FFD9D9;font-family:'Sora',sans-serif;font-weight:600;font-size:19px;margin-top:14px;
  }
  .hero .desc{
    color:#C7D6EA;font-size:16.5px;margin-top:18px;max-width:480px;
  }
  .hero-actions{display:flex;gap:14px;margin-top:32px;flex-wrap:wrap;}
  .hero-stats{display:flex;gap:30px;margin-top:44px;flex-wrap:wrap;}
  .hero-stats div b{display:block;color:var(--white);font-family:'Sora',sans-serif;font-size:22px;font-weight:700;}
  .hero-stats div span{display:block;color:#AFC3DD;font-size:12.5px;margin-top:2px;}

  /* --- 3D truck scene --- */
  .truck-scene{
    position:relative;height:360px;display:flex;align-items:flex-end;justify-content:center;
    perspective:900px;
  }
  .road{
    position:absolute;left:-10%;right:-10%;bottom:38px;height:54px;
    background:linear-gradient(180deg,#1a3660,#0d2545);
    transform:rotateX(55deg);
    border-radius:4px;
  }
  .road::before{
    content:"";position:absolute;top:50%;left:0;right:0;height:4px;transform:translateY(-50%);
    background-image:repeating-linear-gradient(90deg,rgba(255,255,255,0.55) 0 26px, transparent 26px 52px);
    animation:roadmove 1.1s linear infinite;
  }
  @keyframes roadmove{from{background-position-x:0;}to{background-position-x:-78px;}}
  .truck-shadow{
    position:absolute;bottom:26px;width:230px;height:22px;border-radius:50%;
    background:radial-gradient(ellipse at center, rgba(0,0,0,0.42), transparent 72%);
    animation:shadowpulse 3.2s ease-in-out infinite;
  }
  @keyframes shadowpulse{0%,100%{transform:scaleX(1);opacity:.9;}50%{transform:scaleX(.9);opacity:.65;}}
  .truck-3d{
    position:relative;width:260px;height:170px;margin-bottom:44px;
    transform-style:preserve-3d;
    animation:trucklift 3.2s ease-in-out infinite;
  }
  @keyframes trucklift{0%,100%{transform:translateY(0) rotateY(-14deg);}50%{transform:translateY(-9px) rotateY(-14deg);}}
  .truck-cab{
    position:absolute;left:0;bottom:34px;width:78px;height:80px;border-radius:10px 12px 6px 6px;
    background:linear-gradient(145deg,#F4F6F9,#D8E0EA);
    box-shadow:inset -8px 0 14px rgba(10,46,92,0.15), var(--shadow-2);
  }
  .truck-cab::before{ /* windshield */
    content:"";position:absolute;top:10px;left:10px;right:10px;height:30px;border-radius:6px;
    background:linear-gradient(160deg,#8FC3F0,#3E7FC2);
  }
  .truck-box{
    position:absolute;left:70px;bottom:34px;width:170px;height:112px;border-radius:8px;
    background:linear-gradient(155deg,var(--white) 0%, #E7EEF7 55%, #C9D8EA 100%);
    box-shadow:inset -14px 0 20px rgba(10,46,92,0.12), var(--shadow-2);
    border:2px solid rgba(10,46,92,0.06);
  }
  .truck-box::before{
    content:"SOUTH PACKERS";
    position:absolute;top:38%;left:0;right:0;text-align:center;
    font-family:'Sora',sans-serif;font-weight:700;font-size:13px;letter-spacing:.02em;color:var(--blue-800);
  }
  .truck-box::after{
    content:"";position:absolute;left:14px;right:14px;bottom:14px;height:4px;border-radius:4px;background:var(--red-600);opacity:.85;
  }
  .truck-wheel{
    position:absolute;bottom:14px;width:34px;height:34px;border-radius:50%;
    background:radial-gradient(circle at 35% 35%, #4a5568, #10141c 70%);
    border:4px solid #0b0e14;
    animation:wheelspin 0.7s linear infinite;
  }
  @keyframes wheelspin{from{transform:rotate(0);}to{transform:rotate(360deg);}}
  .truck-wheel.w1{left:26px;}
  .truck-wheel.w2{left:172px;}
  .truck-wheel.w3{left:214px;}
  .floating-box{
    position:absolute;width:34px;height:34px;border-radius:6px;
    background:linear-gradient(145deg,#E8EEF6,#C3D3E8);
    box-shadow:var(--shadow-1);
    animation:floatbox 4.5s ease-in-out infinite;
  }
  .floating-box::before{content:"";position:absolute;inset:6px;border:1.5px dashed rgba(10,46,92,0.25);border-radius:3px;}
  .floating-box.fb1{top:6%;left:4%;animation-delay:.2s;}
  .floating-box.fb2{top:18%;right:2%;width:26px;height:26px;animation-delay:1.1s;}
  .floating-box.fb3{top:64%;left:-4%;width:22px;height:22px;animation-delay:2s;}
  @keyframes floatbox{0%,100%{transform:translateY(0) rotate(0deg);}50%{transform:translateY(-14px) rotate(6deg);}}

  @media (max-width:900px){
    .hero-inner{grid-template-columns:1fr;}
    .truck-scene{height:250px;order:-1;}
    .truck-3d{transform:scale(.78) rotateY(-14deg);margin-bottom:10px;}
  }
  @media (prefers-reduced-motion: reduce){
    .truck-3d, .truck-wheel, .road::before, .truck-shadow, .floating-box{animation:none;}
  }

  /* ================= COVERAGE / MAP ================= */
  .coverage{
    background:var(--blue-900);
    padding:96px 0 110px;
    color:var(--white);
    overflow:hidden;
  }
  .coverage-grid{display:grid;grid-template-columns:0.95fr 1.05fr;gap:56px;align-items:center;}
  .coverage .eyebrow-tag{background:rgba(255,255,255,0.08);color:#CFE0F5;}
  .coverage h2{color:var(--white);font-size:clamp(28px,3.6vw,38px);}
  .coverage h2 em{font-style:normal;color:#FF8A8F;}
  .coverage p.lede{color:#B9CBE3;margin-top:16px;font-size:16.5px;max-width:460px;}
  .route-note{
    margin-top:20px;font-size:13.5px;color:#8FA6C4;line-height:1.6;
    border-left:2px solid rgba(255,255,255,0.18);padding-left:14px;
  }
  .coverage-badges{display:flex;gap:14px;margin-top:30px;flex-wrap:wrap;}
  .coverage-badge{
    display:flex;align-items:center;gap:10px;background:rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.14);border-radius:12px;padding:12px 16px;
  }
  .coverage-badge .ico{width:30px;height:30px;border-radius:8px;background:rgba(192,39,45,0.22);display:flex;align-items:center;justify-content:center;}
  .coverage-badge b{display:block;font-size:14px;font-family:'Sora',sans-serif;}
  .coverage-badge span{display:block;font-size:11.5px;color:#9EB2CE;margin-top:1px;}

  .map-stage{position:relative;height:420px;}
  .map-card{
    position:relative;width:100%;height:100%;border-radius:20px;
    background:linear-gradient(160deg,#123C6E, #0A2E5C 65%);
    border:1px solid rgba(255,255,255,0.12);
    box-shadow:0 30px 60px rgba(0,0,0,0.35);
    overflow:hidden;
  }
  .map-card::after{
    content:"Illustrative route map — not to scale";
    position:absolute;bottom:10px;right:14px;font-size:10.5px;color:rgba(255,255,255,0.35);
  }
  .map-svg{width:100%;height:100%;display:block;}
  .map-route-line{
    fill:none;stroke:#FF8A8F;stroke-width:2.4;stroke-dasharray:6 8;
    stroke-linecap:round;
    animation:dashmove 2.4s linear infinite;
  }
  @keyframes dashmove{to{stroke-dashoffset:-56;}}
  .map-node circle.pulse{animation:pulsering 2.4s ease-out infinite;}
  @keyframes pulsering{0%{r:5;opacity:.9;}80%{r:16;opacity:0;}100%{r:16;opacity:0;}}
  .map-label{font-family:'Sora',sans-serif;font-size:11.5px;font-weight:600;fill:#E7EEF7;}
  .map-label.small{font-size:9.5px;fill:#AFC3DD;font-weight:500;}
  @media (prefers-reduced-motion: reduce){
    .map-route-line{animation:none;}
    .map-node circle.pulse{animation:none;}
  }
  @media (max-width:920px){
    .coverage-grid{grid-template-columns:1fr;}
    .map-stage{height:340px;}
  }

  /* ================= SERVICES ================= */
  .services{padding:104px 0;background:var(--ivory);}
  .service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .service-card{
    position:relative;background:var(--white);border:1px solid var(--line);border-radius:16px;
    padding:28px 26px 26px;transform-style:preserve-3d;will-change:transform;
    transition:box-shadow .3s var(--ease), border-color .3s var(--ease);
  }
  .service-card:hover{box-shadow:var(--shadow-3);border-color:transparent;}
  .service-icon{
    width:52px;height:52px;border-radius:13px;
    background:linear-gradient(150deg,var(--blue-600),var(--blue-900));
    display:flex;align-items:center;justify-content:center;margin-bottom:20px;
    box-shadow:0 10px 20px rgba(10,46,92,0.22);
    transform:translateZ(24px);
  }
  .service-icon svg{width:24px;height:24px;stroke:var(--white);}
  .service-card h3{font-size:18.5px;transform:translateZ(14px);}
  .service-card p{margin-top:10px;font-size:14.5px;color:var(--slate);transform:translateZ(10px);}
  .service-card .tag-num{
    position:absolute;top:24px;right:26px;font-family:'Sora',sans-serif;font-weight:700;
    font-size:13px;color:var(--line);
  }
  @media (max-width:920px){.service-grid{grid-template-columns:1fr 1fr;}}
  @media (max-width:600px){.service-grid{grid-template-columns:1fr;}}

  /* ================= HOW IT WORKS ================= */
  .process{padding:100px 0;background:var(--white);}
  .process-track{
    position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:26px;margin-top:10px;
  }
  .process-track::before{
    content:"";position:absolute;top:34px;left:6%;right:6%;height:2px;
    background-image:repeating-linear-gradient(90deg, var(--line) 0 10px, transparent 10px 20px);
  }
  .process-step{position:relative;padding-top:0;}
  .step-badge{
    width:68px;height:68px;border-radius:50%;background:var(--white);
    border:2px solid var(--blue-600);color:var(--blue-700);
    display:flex;align-items:center;justify-content:center;
    font-family:'Sora',sans-serif;font-weight:700;font-size:22px;
    position:relative;z-index:2;margin-bottom:20px;
    box-shadow:0 0 0 8px var(--ivory);
    transition:transform .3s var(--ease), background .3s var(--ease), color .3s var(--ease);
  }
  .process-step:hover .step-badge{background:var(--blue-700);color:var(--white);transform:scale(1.06);}
  .process-step h3{font-size:17.5px;}
  .process-step p{margin-top:8px;font-size:14px;color:var(--slate);}
  @media (max-width:900px){
    .process-track{grid-template-columns:1fr 1fr;row-gap:36px;}
    .process-track::before{display:none;}
  }
  @media (max-width:560px){.process-track{grid-template-columns:1fr;}}

  /* ================= RECENT MOVES ================= */
  .moves{padding:104px 0;background:var(--ivory);}
  .move-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .move-card{
    background:var(--white);border-radius:16px;overflow:hidden;border:1px solid var(--line);
    transition:transform .35s var(--ease), box-shadow .35s var(--ease);
  }
  .move-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-3);}
  .move-photo{
    position:relative;height:168px;
    background:repeating-linear-gradient(135deg, #E4EAF2 0 14px, #ECF1F7 14px 28px);
    display:flex;align-items:center;justify-content:center;
    border-bottom:1px solid var(--line);
  }
  .move-photo .ph-icon{width:40px;height:40px;opacity:.35;}
  .move-photo .ph-label{
    position:absolute;bottom:10px;left:10px;background:rgba(10,46,92,0.85);color:#fff;
    font-size:10.5px;font-weight:600;padding:4px 9px;border-radius:100px;letter-spacing:.02em;
  }
  .move-body{padding:18px 20px 22px;}
  .move-route{display:flex;align-items:center;gap:8px;font-family:'Sora',sans-serif;font-weight:700;font-size:15px;color:var(--blue-900);}
  .move-route .arrow{color:var(--red-600);font-weight:600;}
  .move-service{margin-top:6px;font-size:12.5px;color:var(--blue-600);font-weight:600;}
  .move-desc{margin-top:10px;font-size:13.5px;color:var(--slate);}
  @media (max-width:920px){.move-grid{grid-template-columns:1fr 1fr;}}
  @media (max-width:600px){.move-grid{grid-template-columns:1fr;}}

  /* ================= REVIEWS ================= */
  .reviews{padding:104px 0;background:var(--white);}
  .review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .review-card{
    background:var(--ivory);border:1px solid var(--line);border-radius:16px;padding:26px;
  }
  .review-stars{color:var(--red-600);font-size:15px;letter-spacing:2px;}
  .review-quote{margin-top:14px;font-size:14.5px;color:var(--ink);line-height:1.65;}
  .review-person{display:flex;align-items:center;gap:10px;margin-top:18px;}
  .review-avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(150deg,var(--blue-500),var(--blue-800));display:flex;align-items:center;justify-content:center;color:#fff;font-family:'Sora',sans-serif;font-weight:700;font-size:14px;}
  .review-person b{display:block;font-size:13.5px;}
  .review-person span{display:block;font-size:11.5px;color:var(--slate-light);}
